{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infrapro:diagnostics:v1:observer",
  "additionalProperties": false,
  "properties": {
    "assignment_revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "type": "string"
    },
    "bindings_file": {
      "type": "string"
    },
    "credential_file": {
      "type": "string"
    },
    "instance_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "manifest_file": {
      "type": "string"
    },
    "node_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "server_url": {
      "type": "string"
    },
    "state_dir": {
      "type": "string"
    },
    "tls_ca_file": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "instance_id",
    "node_id",
    "assignment_revision",
    "server_url",
    "manifest_file",
    "bindings_file",
    "credential_file",
    "state_dir"
  ],
  "type": "object"
}
