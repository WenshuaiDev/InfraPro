{
  "schema_version": 1,
  "entries": [
    {
      "id": "ingest-worker",
      "display_name": "设备接入流水",
      "kind": "worker",
      "entry_point": "services/api/cmd/ingest-worker/main.go",
      "lanes": [
        "pull",
        "relay-status",
        "confirmation",
        "identify",
        "planning",
        "parse",
        "source-publication",
        "association-watermark",
        "recovery",
        "object-maintenance"
      ],
      "default_expectation": "disabled",
      "reason": "机器执行独立于人员授权；接收、识别和测量均有持久队列"
    },
    {
      "id": "ingest-relay",
      "display_name": "云端转发",
      "kind": "application",
      "entry_point": "services/ingest-relay/cmd/ingest-relay/main.go",
      "lanes": [
        "control",
        "receivers",
        "spool-maintenance"
      ],
      "default_expectation": "disabled",
      "reason": "独立云 PG 持久缓冲；只接受 mTLS 机器身份，无业务库凭证"
    },
    {
      "id": "ingest-relay-postgres",
      "display_name": "云端缓冲 PostgreSQL",
      "kind": "database",
      "lanes": [],
      "default_expectation": "disabled",
      "reason": "独立于业务数据库，检查 fsync、synchronous_commit 和容量"
    },
    {
      "id": "parser",
      "display_name": "独立解析服务",
      "kind": "application",
      "entry_point": "services/parser/cmd/parser/main.go",
      "lanes": [
        "catalog",
        "parse"
      ],
      "default_expectation": "disabled",
      "reason": "启用试解析时部署；不读取业务存储，按固定产物启动有界子进程"
    },
    {
      "id": "api",
      "display_name": "业务 API",
      "kind": "application",
      "entry_point": "services/api/cmd/api/main.go",
      "lanes": [
        "http"
      ],
      "default_expectation": "continuous",
      "reason": "人员及业务接口进程"
    },
    {
      "id": "monitoring-worker",
      "display_name": "监测、派生计算与试解析",
      "kind": "worker",
      "entry_point": "services/api/cmd/monitoring-worker/main.go",
      "lanes": [
        "scheduler",
        "foreground",
        "historical",
        "parsing",
        "parsing-maintenance"
      ],
      "default_expectation": "continuous",
      "reason": "派生计算在此进程内运行"
    },
    {
      "id": "notification-worker",
      "display_name": "通知投递",
      "kind": "worker",
      "entry_point": "services/api/cmd/notification-worker/main.go",
      "lanes": [
        "delivery"
      ],
      "default_expectation": "continuous",
      "reason": "实际投递循环，本地报告独立于数据库心跳"
    },
    {
      "id": "task-index-worker",
      "display_name": "任务索引",
      "kind": "worker",
      "entry_point": "services/api/cmd/task-index-worker/main.go",
      "lanes": [
        "reconcile",
        "backfill"
      ],
      "default_expectation": "continuous",
      "reason": "任务索引回填与对账"
    },
    {
      "id": "spatial-worker",
      "display_name": "空间转换",
      "kind": "worker",
      "entry_point": "services/api/cmd/spatial-worker/main.go",
      "lanes": [
        "converter",
        "convert"
      ],
      "default_expectation": "continuous",
      "reason": "Python 子进程按需运行"
    },
    {
      "id": "display-package-worker",
      "display_name": "大屏包处理",
      "kind": "worker",
      "entry_point": "services/api/cmd/display-package-worker/main.go",
      "lanes": [
        "maintain",
        "process"
      ],
      "default_expectation": "continuous",
      "reason": "包校验和维护"
    },
    {
      "id": "display-runtime",
      "display_name": "大屏运行服务",
      "kind": "application",
      "entry_point": "services/api/cmd/display-runtime/main.go",
      "lanes": [
        "runtime-http",
        "assets-http"
      ],
      "default_expectation": "continuous",
      "reason": "一个进程、两个独立端点"
    },
    {
      "id": "files-worker",
      "display_name": "普通文件处理",
      "kind": "worker",
      "entry_point": "services/api/cmd/files-worker/main.go",
      "lanes": [
        "heartbeat",
        "cleanup",
        "prepare"
      ],
      "default_expectation": "continuous",
      "reason": "文件准备和清理，缺存储时未配置"
    },
    {
      "id": "files-checker",
      "display_name": "文件检查器",
      "kind": "worker",
      "entry_point": "services/api/cmd/files-checker/main.go",
      "lanes": [
        "socket"
      ],
      "default_expectation": "continuous",
      "reason": "只观察父进程，不探测解析 socket"
    },
    {
      "id": "audit-worker",
      "display_name": "审计维护",
      "kind": "worker",
      "entry_point": "services/api/cmd/audit-worker/main.go",
      "lanes": [
        "reconcile",
        "export"
      ],
      "default_expectation": "continuous",
      "reason": "沿用独立审计方案，不读取审计正文"
    },
    {
      "id": "web",
      "display_name": "业务静态网页",
      "kind": "gateway",
      "lanes": [],
      "default_expectation": "continuous",
      "reason": "登记实际静态服务，不虚构生产 Node 进程"
    },
    {
      "id": "postgres",
      "display_name": "PostgreSQL",
      "kind": "database",
      "lanes": [],
      "default_expectation": "continuous",
      "reason": "只执行 SELECT 1"
    },
    {
      "id": "redis",
      "display_name": "Redis",
      "kind": "cache",
      "lanes": [],
      "default_expectation": "continuous",
      "reason": "只执行 PING"
    },
    {
      "id": "clickhouse",
      "display_name": "ClickHouse",
      "kind": "database",
      "lanes": [],
      "default_expectation": "continuous",
      "reason": "只执行 SELECT 1"
    },
    {
      "id": "keeper",
      "display_name": "ClickHouse Keeper",
      "kind": "database",
      "lanes": [],
      "default_expectation": "disabled",
      "reason": "仅在部署启用并允许 ruok 时检查，不推导 quorum"
    },
    {
      "id": "s3",
      "display_name": "对象存储",
      "kind": "object_store",
      "lanes": [],
      "default_expectation": "external",
      "reason": "只执行 HeadBucket；按实际底层进程补充槽位"
    },
    {
      "id": "seaweed-master",
      "display_name": "SeaweedFS Master",
      "kind": "object_store",
      "lanes": [],
      "default_expectation": "disabled",
      "reason": "拆分部署时单独登记，合一部署不重复计数"
    },
    {
      "id": "seaweed-filer",
      "display_name": "SeaweedFS Filer",
      "kind": "object_store",
      "lanes": [],
      "default_expectation": "disabled",
      "reason": "仅适用已启用的 SeaweedFS 拆分部署"
    },
    {
      "id": "seaweed-volume",
      "display_name": "SeaweedFS Volume",
      "kind": "object_store",
      "lanes": [],
      "default_expectation": "disabled",
      "reason": "仅适用已启用的 SeaweedFS 拆分部署"
    },
    {
      "id": "seaweed-gateway",
      "display_name": "SeaweedFS S3 Gateway",
      "kind": "gateway",
      "lanes": [],
      "default_expectation": "disabled",
      "reason": "仅适用独立 S3 网关进程"
    },
    {
      "id": "python-converter",
      "display_name": "Python 转换器",
      "kind": "tool",
      "lanes": [],
      "default_expectation": "on_demand",
      "reason": "由 spatial-worker 按需启动；空闲时没有子进程正常"
    },
    {
      "id": "maintenance-cli",
      "display_name": "迁移与维护命令",
      "kind": "tool",
      "lanes": [],
      "default_expectation": "on_demand",
      "reason": "一次性 CLI 不属于常驻故障分母"
    },
    {
      "id": "diagnostics-server",
      "display_name": "独立诊断服务",
      "kind": "diagnostics",
      "lanes": [],
      "default_expectation": "continuous",
      "reason": "不依赖业务初始化"
    },
    {
      "id": "diagnostics-observer",
      "display_name": "节点观察器",
      "kind": "diagnostics",
      "lanes": [],
      "default_expectation": "disabled",
      "reason": "需要额外权限或网络视角时独立部署"
    }
  ]
}
