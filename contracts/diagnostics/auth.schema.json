{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infrapro:diagnostics:v1:auth",
  "additionalProperties": false,
  "properties": {
    "revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "users": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "password_hash": {
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "password_hash",
          "enabled",
          "permissions"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "revision",
    "users"
  ],
  "type": "object"
}
