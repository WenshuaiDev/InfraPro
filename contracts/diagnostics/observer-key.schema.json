{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infrapro:diagnostics:v1:observer-key",
  "additionalProperties": false,
  "properties": {
    "generation": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "type": "string"
    },
    "instance_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "key_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "node_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "secret": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "instance_id",
    "node_id",
    "key_id",
    "generation",
    "secret"
  ],
  "type": "object"
}
