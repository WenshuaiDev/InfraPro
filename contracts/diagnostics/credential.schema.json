{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infrapro:diagnostics:v1:credential",
  "additionalProperties": false,
  "properties": {
    "access_key_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "password",
        "bearer",
        "s3"
      ],
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "secret_access_key": {
      "type": "string"
    },
    "session_token": {
      "type": "string"
    },
    "token": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind"
  ],
  "type": "object"
}
