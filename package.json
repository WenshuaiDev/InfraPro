{
  "name": "infrapro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.10.0 <27",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "prototype:spatial": "node scripts/spatial-prototype.mjs",
    "prototype:metrics": "node scripts/metric-catalog-prototype.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --api-only",
    "dev:console": "pnpm --filter @infrapro/console dev",
    "preview": "node scripts/dev.mjs --preview",
    "build": "pnpm build:apps && node scripts/diagnostics-build.mjs --skip-ui --embed-only && node scripts/go.mjs build && node scripts/diagnostics-build.mjs --skip-ui",
    "build:apps": "pnpm --filter './apps/*' -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tools.json",
    "check": "node scripts/go.mjs check && pnpm lint && pnpm typecheck && pnpm contracts:check && pnpm permissions:check",
    "test": "pnpm test:identity && pnpm test:e2e",
    "test:architecture": "node scripts/architecture.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:preview": "INFRAPRO_E2E_PREVIEW=1 node scripts/e2e.mjs",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/architecture-routes.mjs --check && node scripts/nginx-routes.mjs --check && node scripts/ingestion-contract.mjs --check && node scripts/parsing-contract.mjs --check && node scripts/parsing-architecture.mjs && node scripts/diagnostics-contract.mjs --check && node scripts/diagnostics-coverage.mjs && node scripts/audit-contract.mjs --check && node scripts/files-contract.mjs --check && node scripts/task-contract.mjs --check && node scripts/notification-contract.mjs --check && node scripts/display-contract.mjs --check && node scripts/spatial-contract.mjs --check && node scripts/contracts.mjs --check",
    "test:identity": "node scripts/test-identity.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:http": "node scripts/test-http.mjs",
    "test:https": "node scripts/test-https.mjs",
    "test:monitoring:contract": "node scripts/test-monitoring-contract.mjs",
    "infrapro": "node scripts/infrapro.mjs",
    "permissions:generate": "node scripts/permissions.mjs && pnpm contracts:generate",
    "permissions:check": "node scripts/permissions.mjs --check",
    "test:monitoring": "node scripts/test-monitoring.mjs",
    "test:monitoring:client": "node --test tests/unit/monitoring-*.test.mjs",
    "test:monitoring:restore": "node scripts/test-monitoring-restore.mjs",
    "test:derived": "node scripts/test-derived.mjs",
    "test:derived:contract": "node scripts/test-derived.mjs --contract --database",
    "test:derived:load": "node scripts/test-derived.mjs --calculator-load",
    "test:derived:pipeline": "node scripts/test-derived-load.mjs",
    "test:derived:soak": "node scripts/test-derived-soak.mjs",
    "test:derived:database": "node scripts/test-derived.mjs --database",
    "spatial:contracts": "node scripts/spatial-contract.mjs && pnpm contracts:generate",
    "spatial:setup": "uv venv --python 3.12 .artifacts/spatial-venv && uv pip sync --python .artifacts/spatial-venv/bin/python tools/spatial-converter/requirements.lock",
    "test:spatial": "node scripts/test-spatial.mjs",
    "spatial:samples": ".artifacts/spatial-venv/bin/python tools/spatial-converter/samples.py",
    "spatial:browser": "node scripts/spatial-browser-check.mjs",
    "dev:spatial": "node scripts/dev.mjs --spatial",
    "display:contracts": "node scripts/display-contract.mjs && pnpm contracts:generate",
    "display:pack": "node scripts/display-external-check.mjs",
    "display:browser": "node scripts/display-browser-check.mjs",
    "test:display": "node scripts/test-display.mjs",
    "notifications:contracts": "node scripts/notification-contract.mjs && pnpm contracts:generate",
    "test:notifications": "node scripts/test-notifications.mjs",
    "notifications:browser": "node scripts/notifications-browser-check.mjs",
    "test:notifications:client": "node --test tests/unit/notifications-client.test.mjs",
    "test:notifications:restore": "node scripts/test-notifications-restore.mjs",
    "test:notifications:domains": "node scripts/test-notifications-domains.mjs",
    "tasks:contracts": "node scripts/task-contract.mjs && node scripts/notification-contract.mjs && pnpm contracts:generate",
    "test:tasks": "node scripts/test-tasks.mjs",
    "tasks:browser": "node scripts/tasks-browser-check.mjs",
    "files:contracts": "node scripts/files-contract.mjs && pnpm contracts:generate",
    "test:files": "node scripts/test-files.mjs",
    "test:files:http": "node scripts/test-files.mjs --http",
    "test:files:restore": "node scripts/test-files.mjs --restore",
    "test:files:client": "node --test tests/unit/files-*.test.mjs",
    "test:files:sandbox": "node scripts/test-files-sandbox.mjs",
    "files:browser": "node scripts/files-browser-check.mjs",
    "files:preview:browser": "node scripts/files-preview-browser-check.mjs",
    "files:spatial:browser": "node scripts/files-spatial-browser-check.mjs",
    "test:audit": "node scripts/test-audit.mjs",
    "audit:contracts": "node scripts/audit-contract.mjs && node scripts/task-contract.mjs && pnpm contracts:generate",
    "audit:browser": "node scripts/audit-browser-check.mjs",
    "audit:history": "node scripts/audit-history-browser-check.mjs",
    "audit:catalog": "node scripts/audit-contract.mjs --check && node scripts/audit-event-catalog.mjs",
    "test:audit:restore": "node scripts/test-audit.mjs --restore",
    "test:audit:regression": "node scripts/test-audit-regression.mjs",
    "dev:diagnostics": "node scripts/diagnostics-dev.mjs",
    "build:diagnostics": "node scripts/diagnostics-build.mjs",
    "diagnostics:contracts": "node scripts/diagnostics-contract.mjs",
    "diagnostics:coverage": "node scripts/diagnostics-coverage.mjs",
    "diagnostics:lab": "node scripts/diagnostics-lab.mjs",
    "diagnostics:browser": "node scripts/diagnostics-browser-check.mjs",
    "test:diagnostics": "node scripts/test-diagnostics.mjs",
    "test:spatial:environment": "node scripts/spatial-test-environment.mjs",
    "test:diagnostics:environment": "node scripts/diagnostics-test-environment.mjs",
    "local:init": "node scripts/local-runtime.mjs init",
    "local:start": "node scripts/local-runtime.mjs start",
    "local:stop": "node scripts/local-runtime.mjs stop",
    "local:restart": "node scripts/local-runtime.mjs restart",
    "local:status": "node scripts/local-runtime.mjs status",
    "local:cli": "node scripts/local-runtime.mjs cli",
    "parser:contracts": "node scripts/parsing-contract.mjs && node scripts/task-contract.mjs && node scripts/permissions.mjs && pnpm contracts:generate",
    "test:parsing": "node scripts/test-parsing.mjs",
    "parsing:browser": "node scripts/parsing-browser-check.mjs",
    "parsing:lab": "node scripts/parsing-lab.mjs",
    "test:parsing:regression": "node scripts/parsing-regression.mjs",
    "ingestion:contracts": "node scripts/ingestion-contract.mjs && node scripts/parsing-contract.mjs && node scripts/task-contract.mjs && node scripts/audit-contract.mjs && node scripts/permissions.mjs && pnpm contracts:generate",
    "test:ingestion": "node scripts/test-ingestion.mjs",
    "test:ingestion:load": "INFRAPRO_INGESTION_LOAD=1 INGESTION_TEST_PATTERN=TestIngestionSustainedLoad node scripts/test-ingestion.mjs",
    "ingestion:lab": "node scripts/ingestion-lab.mjs",
    "ingestion:simulate": "node scripts/ingestion-simulate.mjs",
    "ingestion:browser": "node scripts/ingestion-browser-check.mjs",
    "test:display:plans": "node scripts/test-display-read-plans.mjs",
    "test:display:load": "node scripts/test-display-read-load.mjs",
    "test:display:restore": "node scripts/test-monitoring-restore.mjs",
    "test:display:compatibility": "node scripts/test-display-compatibility.mjs",
    "display:mock:browser": "node scripts/display-read-mock-browser.mjs",
    "display:rich:browser": "node scripts/display-rich-browser.mjs",
    "test:uploads": "node scripts/test-uploads.mjs",
    "test:mfa": "node scripts/test-mfa.mjs",
    "mfa:lab": "node scripts/mfa-lab.mjs"
  },
  "devDependencies": {
    "@infrapro/eslint-config": "workspace:*",
    "@infrapro/tsconfig": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
