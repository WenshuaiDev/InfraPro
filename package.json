{
  "name": "infrapro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.10.0 <27",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --api-only",
    "dev:console": "pnpm --filter @infrapro/console dev",
    "preview": "node scripts/dev.mjs --preview",
    "build": "node scripts/go.mjs build && pnpm build:apps",
    "build:apps": "pnpm --filter './apps/*' -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tools.json",
    "check": "node scripts/go.mjs check && pnpm lint && pnpm typecheck && pnpm contracts:check && pnpm permissions:check",
    "test": "pnpm test:identity && pnpm test:e2e",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:preview": "INFRAPRO_E2E_PREVIEW=1 node scripts/e2e.mjs",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "test:identity": "node scripts/test-identity.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:http": "node scripts/test-http.mjs",
    "infrapro": "node scripts/infrapro.mjs",
    "permissions:generate": "node scripts/permissions.mjs && pnpm contracts:generate",
    "permissions:check": "node scripts/permissions.mjs --check"
  },
  "devDependencies": {
    "@infrapro/eslint-config": "workspace:*",
    "@infrapro/tsconfig": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
