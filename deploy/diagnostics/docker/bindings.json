{
  "schema_version": 1,
  "instance_id": "example",
  "node_id": "local",
  "assignment_revision": "1",
  "bindings": [
    {
      "id": "diagnostics-process",
      "adapter": "native_process",
      "pid_file": "/var/lib/infrapro-diagnostics/process.json",
      "pid_file_format": "diagnostics",
      "allowed_root": "/var/lib/infrapro-diagnostics",
      "expected_executable": "/usr/local/bin/infrapro-diagnostics",
      "expected_uid": 10001
    },
    {
      "id": "diagnostics-ready",
      "adapter": "http_ready",
      "url": "https://127.0.0.1:8096/readyz",
      "expected_status": 200,
      "expected_json": {
        "status": "ready"
      },
      "tls_ca_file": "/etc/infrapro/diagnostics/tls/ca.pem"
    },
    {
      "id": "local-resources",
      "adapter": "host_resources",
      "scope": "container",
      "mount_paths": [
        {
          "id": "diagnostics",
          "path": "/var/lib/infrapro-diagnostics"
        }
      ]
    }
  ]
}
