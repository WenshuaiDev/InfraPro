{
  "mode": "jetstream",
  "environment": "acceptance",
  "nats_url": "tls://broker-1.internal:4222,tls://broker-2.internal:4222,tls://broker-3.internal:4222",
  "ca_file": "/etc/infrapro/events/ca.pem",
  "cert_file": "/etc/infrapro/events/client.pem",
  "key_file": "/etc/infrapro/events/client.key",
  "replicas": 3,
  "batch": 32,
  "max_ack_pending": 64,
  "max_deliver": 8,
  "work_concurrency": 4,
  "max_attempts": 8,
  "ack_wait_ms": 30000,
  "work_timeout_ms": 120000,
  "relay_poll_ms": 100,
  "fallback_scan_ms": 5000,
  "backoff_ms": 500,
  "max_backoff_ms": 60000,
  "ingestion_bytes": 1073741824,
  "monitoring_bytes": 536870912,
  "auxiliary_bytes": 268435456,
  "disk_soft_percent": 80,
  "disk_hard_percent": 95,
  "retention_seconds": 604800,
  "dedup_seconds": 120
}
