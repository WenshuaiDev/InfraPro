[Unit]
Description=InfraPro private device ingestion worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=infrapro
Group=infrapro
WorkingDirectory=/opt/infrapro
Environment=INFRAPRO_CONFIG=/etc/infrapro/runtime.yaml
Environment=INFRAPRO_DIAGNOSTICS_INSTANCE_ID=inner-platform
Environment=INFRAPRO_DIAGNOSTICS_NODE_ID=inner-node-1
Environment=INFRAPRO_DIAGNOSTICS_REPLICA_ID=ingest-worker-1
Environment=INFRAPRO_DIAGNOSTICS_REPORT_FILE=/run/infrapro-ingestion/process.json
ExecStart=/opt/infrapro/bin/ingest-worker
RuntimeDirectory=infrapro-ingestion
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/infrapro-ingestion

[Install]
WantedBy=multi-user.target
