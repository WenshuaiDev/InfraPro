  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Allow","Action":["s3:ListBucket"],"Resource":["arn:aws:s3:::infrapro-files-private"],"Condition":{"StringLike":{"s3:prefix":["files/v1/*"]}}},
