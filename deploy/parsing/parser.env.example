INFRAPRO_PARSER_ADDR=127.0.0.1:8091
INFRAPRO_PARSER_PACKAGE=/opt/infrapro/parser/current/release
INFRAPRO_PARSER_TOKEN_FILE=/etc/infrapro/parser-machine-token
INFRAPRO_PARSER_RELEASE=release-id
INFRAPRO_PARSER_CONCURRENCY=4
INFRAPRO_PARSER_MEMORY_MIB=256
INFRAPRO_DIAGNOSTICS_INSTANCE_ID=infrapro
INFRAPRO_DIAGNOSTICS_NODE_ID=parser-host
INFRAPRO_DIAGNOSTICS_REPLICA_ID=parser
INFRAPRO_DIAGNOSTICS_REPORT_FILE=/run/infrapro-parser/process.json
# For TLS termination in this process:
# INFRAPRO_PARSER_TLS_CERT=/etc/infrapro/tls/parser.pem
# INFRAPRO_PARSER_TLS_KEY=/etc/infrapro/tls/parser-key.pem
