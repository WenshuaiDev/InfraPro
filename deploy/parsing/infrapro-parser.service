[Unit]
Description=InfraPro fixed-version parsing service
After=network.target

[Service]
User=infrapro-parser
Group=infrapro-parser
EnvironmentFile=/etc/infrapro/parser.env
ExecStart=/opt/infrapro/parser/current/parser
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RuntimeDirectory=infrapro-parser
RuntimeDirectoryMode=0700
ReadWritePaths=/run/infrapro-parser
MemoryMax=1G
TasksMax=64
LimitNOFILE=128
LimitCORE=0
UMask=0077

[Install]
WantedBy=multi-user.target
