# Copy to .env, generate independent random hex secrets, and set your actual HTTP host/contact.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
CSRF_AUTH_KEY=
PUBLIC_ORIGIN=http://your-server:8088
HTTP_PORT=8088
SUPPORT_CONTACT=
# Existing regular file, owned by the container service UID, mode 0600. No default key.
MFA_KEYRING_FILE=/etc/infrapro/private/mfa-keyring.json
MFA_ISSUER=InfraPro
